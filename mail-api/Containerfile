FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app.py .
RUN useradd --create-home --uid 10001 tdngo && chown -R tdngo:tdngo /app
USER tdngo

EXPOSE 8081
CMD ["gunicorn","--bind","0.0.0.0:8081","--workers","2","--threads","4","--timeout","45","app:app"]
